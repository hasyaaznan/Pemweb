                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/masuk",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "masuk"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin@spiders.test\",\n  \"password\": \"password\",\n  \"perangkat\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "  console.log('Token disimpan untuk', pm.response.json().data.peran);",
                  "}"
                ]
